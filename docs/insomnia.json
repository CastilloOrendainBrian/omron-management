{
  "__type": "export",
  "__export_format": 4,
  "_type": "export",
  "resources": [
    {
      "_id": "wrk_omron",
      "_type": "workspace",
      "parentId": null,
      "name": "Omron Management",
      "description": "Backend API for the Omron weight control system. See backend/AGENTS.md for the architecture and docs/schema.dbml for the data model."
    },
    {
      "_id": "env_base",
      "_type": "environment",
      "parentId": "wrk_omron",
      "name": "Base Environment",
      "data": {
        "base_url": "http://localhost:8000",
        "token": "",
        "user_id": "1"
      },
      "dataPropertyOrder": {
        "&": ["base_url", "token", "user_id"]
      },
      "color": "#7d69cb",
      "isPrivate": false
    },
    {
      "_id": "fld_users",
      "_type": "request_group",
      "parentId": "wrk_omron",
      "name": "Users",
      "description": "CRUD for the User resource. All endpoints require auth:sanctum (Bearer token). Set the `token` env var to a Sanctum-issued personal access token."
    },
    {
      "_id": "req_users_index",
      "_type": "request",
      "parentId": "fld_users",
      "name": "List Users",
      "description": "GET /api/users — paginated list. Query `per_page` (1..100, default 25). Requires `viewAny` policy (admin/super-admin).",
      "method": "GET",
      "url": "{{ base_url }}/api/users",
      "headers": [
        {
          "name": "Accept",
          "value": "application/json"
        }
      ],
      "parameters": [
        {
          "name": "per_page",
          "value": "25",
          "disabled": true
        }
      ],
      "body": {},
      "authentication": {
        "type": "bearer",
        "prefix": "Bearer",
        "token": "{{ token }}"
      },
      "metaSortKey": -1
    },
    {
      "_id": "req_users_store",
      "_type": "request",
      "parentId": "fld_users",
      "name": "Create User",
      "description": "POST /api/users — name, email (unique), password (min 8). Requires `create` policy (admin/super-admin).",
      "method": "POST",
      "url": "{{ base_url }}/api/users",
      "headers": [
        {
          "name": "Content-Type",
          "value": "application/json"
        },
        {
          "name": "Accept",
          "value": "application/json"
        }
      ],
      "parameters": [],
      "body": {
        "mimeType": "application/json",
        "text": "{\n  \"name\": \"Jane Doe\",\n  \"email\": \"jane@example.com\",\n  \"password\": \"password123\"\n}"
      },
      "authentication": {
        "type": "bearer",
        "prefix": "Bearer",
        "token": "{{ token }}"
      },
      "metaSortKey": -2
    },
    {
      "_id": "req_users_show",
      "_type": "request",
      "parentId": "fld_users",
      "name": "Show User",
      "description": "GET /api/users/{user} — returns the user plus eager-loaded `profile` and `roles`. Path: set `user_id` env var or replace `{user_id}` in the URL.",
      "method": "GET",
      "url": "{{ base_url }}/api/users/{{ user_id }}",
      "headers": [
        {
          "name": "Accept",
          "value": "application/json"
        }
      ],
      "parameters": [],
      "body": {},
      "authentication": {
        "type": "bearer",
        "prefix": "Bearer",
        "token": "{{ token }}"
      },
      "metaSortKey": -3
    },
    {
      "_id": "req_users_update",
      "_type": "request",
      "parentId": "fld_users",
      "name": "Update User",
      "description": "PUT/PATCH /api/users/{user} — all fields optional (`sometimes`). Self or admin. Password is auto-hashed via cast.",
      "method": "PUT",
      "url": "{{ base_url }}/api/users/{{ user_id }}",
      "headers": [
        {
          "name": "Content-Type",
          "value": "application/json"
        },
        {
          "name": "Accept",
          "value": "application/json"
        }
      ],
      "parameters": [],
      "body": {
        "mimeType": "application/json",
        "text": "{\n  \"name\": \"Jane D.\"\n}"
      },
      "authentication": {
        "type": "bearer",
        "prefix": "Bearer",
        "token": "{{ token }}"
      },
      "metaSortKey": -4
    },
    {
      "_id": "req_users_destroy",
      "_type": "request",
      "parentId": "fld_users",
      "name": "Delete User",
      "description": "DELETE /api/users/{user} — soft delete (sets `deleted_at`). Self or super-admin. Related records (profile, devices, sessions, goals) are kept and hidden by the SoftDeletes global scope.",
      "method": "DELETE",
      "url": "{{ base_url }}/api/users/{{ user_id }}",
      "headers": [
        {
          "name": "Accept",
          "value": "application/json"
        }
      ],
      "parameters": [],
      "body": {},
      "authentication": {
        "type": "bearer",
        "prefix": "Bearer",
        "token": "{{ token }}"
      },
      "metaSortKey": -5
    }
  ]
}
