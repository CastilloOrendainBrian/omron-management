{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": ["src/**/*", "src/**/*.vue", "env.d.ts"],
  "exclude": ["src/main.ts"],
  "compilerOptions": {
    "noUncheckedIndexedAccess": true,
    "composite": true,
    "paths": {
      "@/*": ["./src/*"]
    },
    "lib": [],
    "types": ["node", "jsdom"],
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.vitest.tsbuildinfo"
  }
}
